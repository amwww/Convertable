{
  "name": "convertable",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently -k -n TSC,ELECTRON -c cyan,magenta \"npm run watch\" \"npm run electron:watch\"",
    "build": "tsc",
    "watch": "tsc -w --preserveWatchOutput",
    "electron:watch": "wait-on dist/main.js dist/preload.js dist/index.js && nodemon --delay 1500ms --signal SIGTERM --watch dist --watch index.html --ext js,html --exec \"electron .\"",
    "start": "npm run build && electron ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amwww/Convertable.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/amwww/Convertable/issues"
  },
  "homepage": "https://github.com/amwww/Convertable#readme",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "jszip": "^3.10.1",
    "mime-types": "^3.0.1",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/mime-types": "^2.1.4",
    "concurrently": "^9.2.1",
    "electron": "^34.0.0",
    "nodemon": "^3.1.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  }
}
