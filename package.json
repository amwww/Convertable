{
  "name": "convertable",
  "version": "1.0.0",
  "description": "A small file conversion app.",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently -k -n TSC,ELECTRON -c cyan,magenta \"npm run watch\" \"npm run electron:watch\"",
    "build": "tsc",
    "pack:mac": "npm run build && electron-builder --mac --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "watch": "tsc -w --preserveWatchOutput",
    "electron:watch": "wait-on dist/main.js dist/preload.js dist/index.js && nodemon --delay 1500ms --signal SIGTERM --watch dist --watch index.html --ext js,html --exec \"electron .\"",
    "start": "npm run build && electron ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amwww/Convertable.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/amwww/Convertable/issues"
  },
  "homepage": "https://github.com/amwww/Convertable#readme",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@img/sharp-libvips-darwin-arm64": "^1.2.4",
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.5.16",
    "jszip": "^3.10.1",
    "mime-types": "^3.0.1",
    "node-unrar-js": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.3",
    "tar": "^7.5.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^25.0.9",
    "concurrently": "^9.2.1",
    "electron": "^34.0.0",
    "electron-builder": "^24.13.3",
    "nodemon": "^3.1.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.amwww.convertable",
    "productName": "Convertable",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "index.html",
      "preload.cjs",
      "package.json",
      "node_modules/**/*",
      "!**/node_modules/*/{test,tests,__tests__,example,examples}/**",
      "!**/node_modules/.cache/**",
      "!tktinker/**",
      "!build/**",
      "!outputs/**"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "icon": "tktinker/assets/icon.icns",
      "identity": null
    }
  }
}
