{
  "name": "convertable",
  "version": "1.0.0",
  "description": "A small file conversion app.",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently -k -n TSC,ELECTRON -c cyan,magenta \"npm run watch\" \"npm run electron:watch -- --no-watch\"",
    "dev:watch": "concurrently -k -n TSC,ELECTRON -c cyan,magenta \"npm run watch\" \"npm run electron:watch\"",
    "build": "tsc",
    "pack:mac": "npm run build && electron-builder --mac --dir",
    "pack:mac:unsigned": "npm run build && electron-builder --mac --dir -c.mac.identity=null",
    "pack:mac:arm64": "npm run build && electron-builder --mac --arm64 --dir",
    "pack:mac:x64": "npm run build && electron-builder --mac --x64 --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:unsigned": "npm run build && electron-builder --mac -c.mac.identity=null",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "dist:mac:x64": "npm run build && electron-builder --mac --x64",
    "dist:mac:all": "npm run build && electron-builder --mac --arm64 --x64",
    "watch": "tsc -w --preserveWatchOutput",
    "electron:watch": "node scripts/electron-dev.mjs",
    "start": "npm run build && electron ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amwww/Convertable.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/amwww/Convertable/issues"
  },
  "homepage": "https://github.com/amwww/Convertable#readme",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.6.2",
    "electron-store": "^10.0.0",
    "jszip": "^3.10.1",
    "mime-types": "^3.0.1",
    "node-unrar-js": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.3",
    "tar": "^7.5.7"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-darwin-arm64": "^1.2.4",
    "@img/sharp-libvips-darwin-x64": "^1.2.4"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@types/adm-zip": "^0.5.7",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^25.0.9",
    "concurrently": "^9.2.1",
    "electron": "^34.0.0",
    "electron-builder": "^24.13.3",
    "nodemon": "^3.1.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.amwww.convertable",
    "productName": "Convertable",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "index.html",
      "preload.cjs",
      "package.json",
      "node_modules/**/*",
      "!**/node_modules/*/{test,tests,__tests__,example,examples}/**",
      "!**/node_modules/.cache/**",
      "!tktinker/**",
      "!build/**",
      "!outputs/**"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.inherit.plist",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build-resources/icon.icns",
      "gatekeeperAssess": false
    },
    "afterSign": "scripts/notarize.mjs",
    "publish": [
      {
        "provider": "github",
        "owner": "amwww",
        "repo": "Convertable"
      }
    ]
  }
}
